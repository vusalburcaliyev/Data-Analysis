{
  "name": "OnlineRetail",
  "compatibilityLevel": 1600,
  "model": {
    "name": "Model",
    "culture": "en-US",
    "sourceQueryCulture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "discourageImplicitMeasures": true,
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Sales and Credits\", \"Buyer Summary\", \"Credit Codes\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ],
    "tables": [
      {
        "name": "Sales and Credits",
        "columns": [
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none"
          },
          {
            "name": "Country",
            "dataType": "string",
            "sourceColumn": "Country",
            "summarizeBy": "none"
          },
          {
            "name": "Gross cents",
            "dataType": "int64",
            "sourceColumn": "Gross cents",
            "summarizeBy": "none"
          },
          {
            "name": "Credit cents",
            "dataType": "int64",
            "sourceColumn": "Credit cents",
            "summarizeBy": "none"
          },
          {
            "name": "Invoices",
            "dataType": "int64",
            "sourceColumn": "Invoices",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Gross sales",
            "expression": "DIVIDE(SUM('Sales and Credits'[Gross cents]), 100)",
            "formatString": "£#,0.00;(£#,0.00)"
          },
          {
            "name": "Recorded credits",
            "expression": "DIVIDE(SUM('Sales and Credits'[Credit cents]), 100)",
            "formatString": "£#,0.00;(£#,0.00)"
          },
          {
            "name": "Net recorded sales",
            "expression": "[Gross sales] - [Recorded credits]",
            "formatString": "£#,0.00;(£#,0.00)"
          },
          {
            "name": "Sales invoices",
            "expression": "SUM('Sales and Credits'[Invoices])",
            "formatString": "#,0"
          },
          {
            "name": "Average invoice value",
            "expression": "DIVIDE([Gross sales], [Sales invoices])",
            "formatString": "£#,0.00;(£#,0.00)"
          },
          {
            "name": "Credit share of sales",
            "expression": "DIVIDE([Recorded credits], [Gross sales])",
            "formatString": "0.00%"
          }
        ],
        "partitions": [
          {
            "name": "Sales and Credits",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Snapshot = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Snapshot, type table [#\"Month\" = nullable text, #\"Country\" = nullable text, #\"Gross cents\" = nullable number, #\"Credit cents\" = nullable number, #\"Invoices\" = nullable number]),",
                "    Typed = Table.TransformColumnTypes(Rows, {{\"Gross cents\", Int64.Type}, {\"Credit cents\", Int64.Type}, {\"Invoices\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Buyer Summary",
        "columns": [
          {
            "name": "Buyer group",
            "dataType": "string",
            "sourceColumn": "Buyer group",
            "summarizeBy": "none"
          },
          {
            "name": "Buyers",
            "dataType": "int64",
            "sourceColumn": "Buyers",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Known buyers",
            "expression": "SUM('Buyer Summary'[Buyers])",
            "formatString": "#,0"
          },
          {
            "name": "Repeat buyer rate",
            "expression": "DIVIDE(CALCULATE([Known buyers], 'Buyer Summary'[Buyer group] = \"Two or more invoices\"), [Known buyers])",
            "formatString": "0.00%"
          }
        ],
        "partitions": [
          {
            "name": "Buyer Summary",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Snapshot = Json.Document(Binary.Decompress(Binary.FromText(\"i45W8s9LVcjMK8vPTE5V0jE0NbaI1YlWCinPV8gvUsjNL4JLFivpGJmbWsbGAgA=\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Snapshot, type table [#\"Buyer group\" = nullable text, #\"Buyers\" = nullable number]),",
                "    Typed = Table.TransformColumnTypes(Rows, {{\"Buyers\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Credit Codes",
        "columns": [
          {
            "name": "Stock code",
            "dataType": "string",
            "sourceColumn": "Stock code",
            "summarizeBy": "none"
          },
          {
            "name": "Credit cents",
            "dataType": "int64",
            "sourceColumn": "Credit cents",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Value credited",
            "expression": "DIVIDE(SUM('Credit Codes'[Credit cents]), 100)",
            "formatString": "£#,0.00;(£#,0.00)"
          }
        ],
        "partitions": [
          {
            "name": "Credit Codes",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Snapshot = Json.Document(Binary.Decompress(Binary.FromText(\"Lc45bgMxDAXQqwSqVXBfStmZxIDhBXbSZDD3v0aosUs+8H9yXdu4jL/b9WtZWifQ0DDe+touraMYe+I+EqNZ6+7iaTLlfnv+1A4Gg+9AJMStp2EYTDiM6/njeBqP7+VZURZ4JY+P33PrFkyZcw5F4lFihKx7FSJEgSobTfhsXc1c5f0L1iEJYLAJEhhaoCoJ77wXsLvy/r54xQ8llpSvE0ReJayQDtv2Dw==\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Snapshot, type table [#\"Stock code\" = nullable text, #\"Credit cents\" = nullable number]),",
                "    Typed = Table.TransformColumnTypes(Rows, {{\"Credit cents\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
    "relationships": []
  }
}
